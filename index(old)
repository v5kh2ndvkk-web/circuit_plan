        let elapsedSeconds = 0;
        const totalSeconds = 35 * 60; // 2100 seconds
        let timerInterval = null;
        let isRunning = false;

        const stagesConfig = [
            { id: 1, startMin: 0, endMin: 3, label: '階段 1｜引入診斷' },
            { id: 2, startMin: 3, endMin: 12, label: '階段 2｜LED 等勢圖' },
            { id: 3, startMin: 12, endMin: 19, label: '階段 3｜電壓與歐姆定律' },
            { id: 4, startMin: 19, endMin: 27, label: '階段 4｜混聯電壓拆解' },
            { id: 5, startMin: 27, endMin: 35, label: '階段 5｜實戰闖關評估' }
        ];

        function formatTime(sec) {
            const m = Math.floor(sec / 60);
            const s = sec % 60;
            return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        function updateTimerUI() {
            const display = document.getElementById('timer-display');
            const progressBar = document.getElementById('timeline-progress-bar');
            const stageLabel = document.getElementById('timer-stage-label');

            display.innerHTML = `${formatTime(elapsedSeconds)} <span class="text-xs font-normal text-slate-400">/ 35:00</span>`;
            const pct = Math.min(100, (elapsedSeconds / totalSeconds) * 100);
            progressBar.style.width = `${pct}%`;

            const currentMin = elapsedSeconds / 60;
            let activeStage = stagesConfig[4];
            for (const st of stagesConfig) {
                if (currentMin >= st.startMin && currentMin < st.endMin) {
                    activeStage = st;
                    break;
                }
            }

            if (elapsedSeconds >= totalSeconds) {
                stageLabel.textContent = '課節完成｜35:00 結束';
                display.classList.remove('text-emerald-600');
                display.classList.add('text-amber-600');
            } else {
                stageLabel.textContent = activeStage.label;
                display.classList.add('text-emerald-600');
                display.classList.remove('text-amber-600');
            }

            stagesConfig.forEach(st => {
                const pill = document.getElementById(`nav-stage-${st.id}`);
                const card = document.getElementById(`stage-card-${st.id}`);
                if (st.id === activeStage.id) {
                    pill.className = 'stage-pill text-left px-2.5 py-1.5 rounded-lg bg-indigo-50 border border-indigo-400 text-indigo-900 font-bold transition truncate';
                    if (card) {
                        card.classList.add('active-stage', 'border-2', 'border-indigo-500');
                        card.classList.remove('border', 'border-slate-200');
                    }
                } else {
                    pill.className = 'stage-pill text-left px-2.5 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 font-medium transition hover:bg-slate-200/70 truncate';
                    if (card) {
                        card.classList.remove('active-stage', 'border-2', 'border-indigo-500');
                        card.classList.add('border', 'border-slate-200');
                    }
                }
            });
        }

        function toggleTimer() {
            const btn = document.getElementById('btn-timer-toggle');
            const icon = document.getElementById('icon-timer-toggle');
            const text = document.getElementById('text-timer-toggle');

            if (isRunning) {
                clearInterval(timerInterval);
                isRunning = false;
                btn.classList.remove('bg-amber-600', 'hover:bg-amber-500');
                btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
                icon.className = 'fa-solid fa-play';
                text.textContent = '繼續';
            } else {
                isRunning = true;
                btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
                btn.classList.add('bg-amber-600', 'hover:bg-amber-500');
                icon.className = 'fa-solid fa-pause';
                text.textContent = '暫停';
                timerInterval = setInterval(() => {
                    if (elapsedSeconds < totalSeconds) {
                        elapsedSeconds++;
                        updateTimerUI();
                    } else {
                        clearInterval(timerInterval);
                        isRunning = false;
                        showToast('35 分鐘課節時間到！');
                    }
                }, 1000);
            }
        }

        function adjustTime(deltaSec) {
            elapsedSeconds = Math.max(0, Math.min(totalSeconds, elapsedSeconds + deltaSec));
            updateTimerUI();
        }

        function resetTimer() {
            if (isRunning) toggleTimer();
            elapsedSeconds = 0;
            document.getElementById('text-timer-toggle').textContent = '開始';
            updateTimerUI();
        }

        function jumpToStage(stageId, startMinutes) {
            switchTab('flow');
            elapsedSeconds = startMinutes * 60;
            updateTimerUI();
            const card = document.getElementById(`stage-card-${stageId}`);
            if (card) {
                const yOffset = -125;
                const y = card.getBoundingClientRect().top + window.pageYOffset + yOffset;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        }

        // ==========================================
        // 4. Left-Hand Sidebar Tab Switching
        // ==========================================
        function switchTab(tabName) {
            const tabs = ['pgde', 'flow', 'constructivism', 'matrix', 'game'];
            tabs.forEach(t => {
                const panel = document.getElementById(`tab-panel-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (!panel || !btn) return;
                if (t === tabName) {
                    panel.classList.remove('hidden');
                    btn.className = 'tab-btn w-full text-left px-3.5 py-3 rounded-xl font-bold text-sm bg-indigo-600 text-white shadow-sm transition flex items-center gap-2.5';
                } else {
                    panel.classList.add('hidden');
                    btn.className = 'tab-btn w-full text-left px-3.5 py-3 rounded-xl font-bold text-sm bg-white text-slate-700 hover:bg-slate-100 transition flex items-center gap-2.5';
                }
            });
            renderAllMath();
        }

        // ==========================================
        // 5. Projector, QR Code & Random Picker Modals
        // ==========================================
        function openProjector(slideKey) {
            const slide = projectorSlides[slideKey];
            if (!slide) return;

            const titleEl = document.getElementById('projector-title');
            const qEl = document.getElementById('projector-question');
            const hEl = document.getElementById('projector-hint');

            titleEl.textContent = slide.title;
            qEl.textContent = slide.question;
            hEl.textContent = slide.hint;
            hEl.classList.add('hidden');

            const modal = document.getElementById('projector-modal');
            modal.classList.remove('hidden');
            renderAllMath(modal);
        }

        function toggleProjectorHint() {
            const hEl = document.getElementById('projector-hint');
            hEl.classList.toggle('hidden');
            renderAllMath(hEl);
        }

        function openQrModal() {
            const modal = document.getElementById('qr-modal');
            modal.classList.remove('hidden');
            renderAllMath(modal);
        }

        function openPickerModal() {
            const modal = document.getElementById('picker-modal');
            modal.classList.remove('hidden');
            renderAllMath(modal);
        }

        function closeModal(modalId) {
            const el = document.getElementById(modalId);
            if (el) el.classList.add('hidden');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                ['projector-modal', 'qr-modal', 'picker-modal'].forEach(closeModal);
            }
        });

        ['projector-modal', 'qr-modal', 'picker-modal'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('click', (e) => {
                    if (e.target === el) closeModal(id);
                });
            }
        });

        // ==========================================
        // 6. QR Code Generation & Clipboard Copy
        // ==========================================
        function initQRCodes() {
            const wsUrl = 'https://v5kh2ndvkk-web.github.io/circuit_ws/';
            const gameUrl = 'https://v5kh2ndvkk-web.github.io/circuit/';

            const targets = [
                { id: 'inline-ws-qrcode', url: wsUrl, size: 135 },
                { id: 'inline-qrcode', url: gameUrl, size: 135 },
                { id: 'modal-ws-qrcode', url: wsUrl, size: 195 },
                { id: 'modal-qrcode', url: gameUrl, size: 195 }
            ];

            if (typeof QRCode !== 'undefined') {
                targets.forEach(item => {
                    const box = document.getElementById(item.id);
                    if (box) {
                        box.innerHTML = '';
                        new QRCode(box, {
                            text: item.url,
                            width: item.size,
                            height: item.size,
                            colorDark: '#0f172a',
                            colorLight: '#ffffff',
                            correctLevel: QRCode.CorrectLevel.M
                        });
                    }
                });
            }
        }

        function copyUrlById(inputId, successMsg) {
            const input = document.getElementById(inputId);
            if (!input) return;
            input.select();
            input.setSelectionRange(0, 99999);
            try {
                document.execCommand('copy');
                showToast(successMsg);
            } catch (err) {
                showToast('請手動選取網址複製');
            }
        }

        // ==========================================
        // 7. Toast Banner & Random Student Picker
        // ==========================================
        let toastTimer = null;
        function showToast(msg) {
            const banner = document.getElementById('toast-banner');
            const msgEl = document.getElementById('toast-message');
            if (!banner || !msgEl) return;
            msgEl.textContent = msg;
            banner.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                banner.classList.add('translate-y-20', 'opacity-0');
            }, 2800);
        }

        let pickedNumbers = [];
        let isRolling = false;

        function updatePickerHistoryUI() {
            const historyBox = document.getElementById('picker-history');
            if (!historyBox) return;
            if (pickedNumbers.length === 0) {
                historyBox.innerHTML = '<span class="text-slate-400">尚未抽取</span>';
                return;
            }
            historyBox.innerHTML = pickedNumbers
                .map(n => `<span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-bold">${String(n).padStart(2, '0')} 號</span>`)
                .join('');
        }

        function pickRandomStudent() {
            if (isRolling) return;
            const maxInput = document.getElementById('picker-max');
            const maxStudents = Math.max(1, Math.min(50, parseInt(maxInput.value, 10) || 17));

            const available = [];
            for (let i = 1; i <= maxStudents; i++) {
                if (!pickedNumbers.includes(i)) available.push(i);
            }
            if (available.length === 0) {
                pickedNumbers = [];
                for (let i = 1; i <= maxStudents; i++) available.push(i);
                showToast('全班學號已抽完一輪，自動重新洗牌！');
            }

            isRolling = true;
            const numEl = document.getElementById('picker-result-number');
            const statusEl = document.getElementById('picker-result-class');
            statusEl.textContent = '正在隨機抽取中六同學...';

            let ticks = 0;
            const rollTimer = setInterval(() => {
                const randPreview = Math.floor(Math.random() * maxStudents) + 1;
                numEl.textContent = `${String(randPreview).padStart(2, '0')} 號`;
                ticks++;
                if (ticks >= 14) {
                    clearInterval(rollTimer);
                    const chosen = available[Math.floor(Math.random() * available.length)];
                    pickedNumbers.push(chosen);
                    numEl.textContent = `${String(chosen).padStart(2, '0')} 號`;
                    statusEl.textContent = `中六班｜抽中第 ${chosen} 號同學`;
                    updatePickerHistoryUI();
                    isRolling = false;
                }
            }, 55);
        }

        function clearPickedHistory() {
            pickedNumbers = [];
            updatePickerHistoryUI();
            document.getElementById('picker-result-number').textContent = '--';
            document.getElementById('picker-result-class').textContent = '已清除紀錄，準備抽籤';
        }

        // ==========================================
        // 8. Initialize on Page Load
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            updateTimerUI();
            initQRCodes();
            renderAllMath();
        });

        window.addEventListener('load', () => {
            renderAllMath();
        });
    </script>
</body>
</html>
